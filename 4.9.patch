 		io-channels = <&pmi8998_rradc 2>,
 			      <&pmi8998_rradc 12>;
 		io-channel-names = "charger_temp",
@@ -85,6 +90,11 @@ smb1355_1: qcom,smb1355@c {
 		interrupt-parent = <&smb1355_1>;
 		status = "disabled";
 
+#ifdef CONFIG_LIMITLESS
+		qcom,fastchg-current-ma = <2800>;
