+#endif
+
 		io-channels = <&pmi8998_rradc 2>,
 			      <&pmi8998_rradc 12>;
 		io-channel-names = "charger_temp",
diff --git a/drivers/power/supply/qcom/qpnp-smb2.c b/drivers/power/supply/qcom/qpnp-smb2.c
