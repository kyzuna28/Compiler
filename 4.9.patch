diff --git a/drivers/clk/qcom/clk-cpu-osm.c b/drivers/clk/qcom/clk-cpu-osm.c
index 48ea05d15dd3..8ee8c84a6a7d 100644
--- a/drivers/clk/qcom/clk-cpu-osm.c
+++ b/drivers/clk/qcom/clk-cpu-osm.c
@@ -527,6 +527,63 @@ static struct clk_osm perfcl_clk = {
 	.hw.init = &osm_clks_init[2],
 };
  
+/* --- Limitless S-OC --- */
+#ifdef CONFIG_LIMITLESS
+static int thre_cpu_level = 0; /* Set bawaan ke 0 (Default) */
+static int set_cpu_level(const char *val, const struct kernel_param *kp);
+
+static const struct kernel_param_ops cpu_level_ops = {
+	.set = set_cpu_level,
+	.get = param_get_int,
+};
+
+module_param_cb(thre_oc_level, &cpu_level_ops, &thre_cpu_level, 0644);
+
+/* Limitless S-OC Level: Throttling Max Frequency */
+static int set_cpu_level(const char *val, const struct kernel_param *kp)
+{
+	int ret, level;
+	struct clk_osm *c = &perfcl_clk; /* Fokus ke kluster Prime/Gold */
+	unsigned long target_max_rate;
+
+	ret = kstrtoint(val, 10, &level);
+	if (ret) return ret;
+
+	/* Batasi input level dari -3 (Void) sampai 4 (Prime) */
+	if (level < -3) level = -3;
+	if (level > 4) level = 4;
+
+	thre_cpu_level = level;
+
+	if (c && c->hw.init) {
+		switch (level) {
+			case 4: target_max_rate = 2803200000; break; /* 4 (Prime) - ~2.80 GHz */
+			case 3: target_max_rate = 2457600000; break; /* 3 (Velocity) - ~2.45 GHz */
+			case 2: target_max_rate = 2188800000; break; /* 2 (Swift) - ~2.18 GHz */
+			case 1: target_max_rate = 1996800000; break; /* 1 (Lite) - ~1.99 GHz */
+			case 0: target_max_rate = 1766400000; break; /* 0 (Default) - ~1.76 GHz */
+			case -1: target_max_rate = 1420800000; break; /* -1 (Eco) - ~1.42 GHz */
+			case -2: target_max_rate = 1132800000; break; /* -2 (Chill) - ~1.13 GHz */
+			case -3: target_max_rate = 825600000; break;  /* -3 (Void) - ~0.82 GHz */
+			default: target_max_rate = 1766400000; break; /* Aman di Default */
+		}
+
+		/* Terapkan pembatasan frekuensi langsung ke hardware clock */
+		c->hw.init->rate_max[VDD_GX_HIGH_L1] = target_max_rate;
+		c->hw.init->rate_max[VDD_GX_NOMINAL] = target_max_rate;
+		
+		/* Paksa turun jika frekuensi saat ini nyangkut di atas target baru */
+		if (clk_hw_get_rate(&c->hw) > target_max_rate) {
+			clk_set_rate(c->hw.clk, target_max_rate);
+		}
+
+		pr_info("Limitless S-OC: Profile '%d' applied. CPU Max Rate limited to %lu Hz\n", level, target_max_rate);
+	}
+	return 0;
+}
+#endif
+/* linex Project */
  
