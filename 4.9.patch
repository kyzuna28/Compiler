 {
 	struct kstat stat;
@@ -208,6 +212,10 @@ SYSCALL_DEFINE2(fstat, unsigned int, fd, struct __old_kernel_stat __user *, stat
 	if (!error)
 		error = cp_old_stat(&stat, statbuf);
 
+#ifdef CONFIG_KSU_MANUAL_HOOK
+	ksu_handle_newfstat_ret(&fd, (struct stat __user **)&statbuf);
+#endif
+
 	return error;
