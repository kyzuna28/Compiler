From 557d09ea94b778648b03ca70d83df6c1492289da Mon Sep 17 00:00:00 2001
From: kyzuna28 <122950944+kyzuna28@users.noreply.github.com>
Date: Sat, 6 Jun 2026 19:10:25 +0000
Subject: [PATCH] kernel: Apply patch 4.9

---
 .gitignore                            |   3 +
 arch/arm64/boot/dts/qcom/smb1355.dtsi |  10 +++
 drivers/power/supply/qcom/qpnp-smb2.c |   4 +
 drivers/power/supply/qcom/smb5-lib.c  |   5 ++
 fs/proc/version.c                     |  17 ++++
 fs/sdcardfs/sdcardfs.h                |   3 +
 init/Kconfig                          |   7 ++
 init/version.c                        | 115 ++++++++++++++++++++++++++
 8 files changed, 164 insertions(+)

diff --git a/.gitignore b/.gitignore
index 08381b628..d9a64e2c1 100644
--- a/.gitignore
+++ b/.gitignore
@@ -124,6 +124,9 @@ kernel/configs/android-*.cfg
