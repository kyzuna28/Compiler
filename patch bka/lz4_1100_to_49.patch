+static void LZ4_writeLE16(void *memPtr, U16 value)
+{
+	if (LZ4_isLittleEndian()) {
+		LZ4_write16(memPtr, value);
+	} else {
+		BYTE *p = (BYTE *)memPtr;
+		p[0] = (BYTE)value;
+		p[1] = (BYTE)(value >> 8);
+	}
