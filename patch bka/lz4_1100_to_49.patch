+{
+	if (LZ4_isLittleEndian()) {
+		return LZ4_read32(memPtr);
+	} else {
+		const BYTE *p = (const BYTE *)memPtr;
+		return (U32)p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24);
