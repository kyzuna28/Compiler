diff '--color=auto' -Naur '--exclude=.git' '--exclude=.github' '--exclude=*.o' a/drivers/char/srandom/11-srandom.rules b/drivers/char/srandom/11-srandom.rules
--- a/drivers/char/srandom/11-srandom.rules	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/char/srandom/11-srandom.rules	2025-12-02 15:47:37.893400353 +0800
@@ -0,0 +1,6 @@
+#
+#  Use the following to "replace /dev/urandom
+#
+ACTION=="add", KERNEL=="srandom", MODE="0664", RUN+="/bin/bash -c '/usr/bin/srandom set'"
+ACTION=="change", KERNEL=="srandom", MODE="0664", RUN+="/bin/bash -c '/usr/bin/srandom set'"
+ACTION=="remove", KERNEL=="srandom", RUN+="/bin/bash -c '/usr/bin/srandom default'"
diff '--color=auto' -Naur '--exclude=.git' '--exclude=.github' '--exclude=*.o' a/drivers/char/srandom/Kconfig b/drivers/char/srandom/Kconfig
--- a/drivers/char/srandom/Kconfig	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/char/srandom/Kconfig	2025-12-02 15:48:23.011309089 +0800
@@ -0,0 +1,12 @@
+config SRANDOM
+	tristate "Seed Random Number Generator by josenk"
+	default y
+
+	---help---
+	  This driver provides kernel-side support for
+	  Seed Random Number Generator.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called srandom.
+
+	  If unsure, say Y.
