--- a/drivers/char/srandom/srandom.c	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/char/srandom/srandom.c	2025-12-02 16:05:30.276534947 +0800
@@ -0,0 +1,563 @@
+/*
